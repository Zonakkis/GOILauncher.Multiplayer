<Project>
    <!-- 只对src下的项目生效 -->
    <PropertyGroup
        Condition="
        '$(MSBuildProjectName)' == 'Core' Or
        '$(MSBuildProjectName)' == 'Client' Or
        '$(MSBuildProjectName)' == 'Server' Or
        '$(MSBuildProjectName)' == 'Unity' Or
        '$(MSBuildProjectName)' == 'Unity.Desktop' Or
        '$(MSBuildProjectName)' == 'DedicatedServer' Or
        '$(MSBuildProjectName)' == 'Multiplayer.Tests' Or
        '$(MSBuildProjectName)' == 'DedicatedServer.Tests'">

        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
        <!-- Autofac -->
        <PackageVersion Include="Autofac" Version="9.3.4" />
        <PackageVersion Update="Autofac"
            Version="2.6.3.862"
            Condition="'$(TargetFramework)' == 'net35'" />
        <PackageVersion Update="Autofac"
            Version="3.5.2"
            Condition="'$(TargetFramework)' == 'net40'" />

        <!-- NLog -->
        <PackageVersion Include="NLog" Version="6.2.1" />

        <!-- BepInEx -->
        <PackageVersion Include="BepInEx.Analyzers" Version="1.0.8" />
        <PackageVersion Include="BepInEx.Core" Version="5.4.21" />
        <PackageVersion Include="BepInEx.PluginInfoProps" Version="2.1.0" />

        <!-- 测试依赖 -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
        <PackageVersion Include="FluentAssertions" Version="8.11.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
    </ItemGroup>
</Project>