<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GOILauncher.Multiplayer.Core</AssemblyName>
    <RootNamespace>GOILauncher.Multiplayer.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{908CF820-B1AB-40A3-A504-96DFC6BC3B40}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WithoutNet35)' == 'true'">
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WithoutNet35)' != 'true'">
    <TargetFramework>netstandard2.0;net35</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteNetLib\LiteNetLib.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="Autofac" Version="2.6.3.862" />
    <PackageReference Include="NLog" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Autofac" Version="4.9.4" />
    <PackageReference Include="NLog" Version="6.1.1" />
  </ItemGroup>

</Project>