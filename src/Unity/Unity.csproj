<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;netstandard2.0</TargetFrameworks>
    <AssemblyName>GOILauncher.Multiplayer.Unity</AssemblyName>
    <RootNamespace>GOILauncher.Multiplayer.Unity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{125C7A1A-0023-4E64-A620-E808AE58D966}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="Autofac" Version="2.6.3.862" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Autofac" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The game supplies its own assemblies at runtime, so these are compile-time only.
      Without Private=False they are copy-local and flow through every ProjectReference
      into the BepInEx plugin payload, which would ship stale Android-built copies of the
      game's own assemblies alongside the real ones.
    -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\UnityLibraries\Android\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\UnityLibraries\Android\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\UnityLibraries\Android\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\UnityLibraries\Android\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\UnityLibraries\Android\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>..\UnityLibraries\Android\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      原版罐子贴图。文件缺失时不参与编译，VanillaPotTexture 会退化成"不改贴图"并警告一行——
      少一张图不该让整个仓库编不过。
    -->
    <EmbeddedResource Include="Resources\VanillaPot.png" Condition="Exists('Resources\VanillaPot.png')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\Client.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

</Project>