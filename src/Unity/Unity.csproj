<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net35;net40;netstandard2.0</TargetFrameworks>
    <AssemblyName>GOILauncher.Multiplayer.Unity</AssemblyName>
    <RootNamespace>GOILauncher.Multiplayer.Unity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{125C7A1A-0023-4E64-A620-E808AE58D966}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
  </ItemGroup>

  <!-- 定义游戏目标平台以及dll路径 -->
  <PropertyGroup>
    <GameTarget Condition="'$(GameTarget)' == ''">Windows</GameTarget>
    <GameLib Condition="$(GameTarget) == 'Windows'">..\..\lib\Windows\Original-1.7</GameLib>
    <GameLib Condition="$(GameTarget) == 'Android'">..\..\lib\Android\Original-1.9.2</GameLib>
    <DefineConstants>$(DefineConstants);GAME_$(GameTarget.ToUpperInvariant())</DefineConstants>
  </PropertyGroup>

  <!-- 游戏目标平台引用的dll -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLib)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLib)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLib)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameLib)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameLib)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameLib)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      原版皮肤基线贴图，每个槽位一张。文件缺失时不参与编译，VanillaPotTexture 会退化成
      "不改贴图"并警告一行——少一张图不该让整个仓库编不过。
    -->
    <EmbeddedResource Include="Resources\VanillaPot.png"
      Condition="Exists('Resources\VanillaPot.png')" />
    <EmbeddedResource Include="Resources\VanillaDiogenes.png"
      Condition="Exists('Resources\VanillaDiogenes.png')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\Client.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

</Project>