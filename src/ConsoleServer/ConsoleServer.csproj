<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ConsoleServer</AssemblyName>
    <RootNamespace>ConsoleServer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{858EE83C-5E77-42AF-9E0F-A29983265D7E}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Autofac stays at 4.9.4 to match the netstandard2.0 builds of Core/Server it composes
      against — one version on the whole non-game side keeps assembly resolution trivial.
    -->
    <PackageReference Include="Autofac" Version="4.9.4" />
    <PackageReference Include="NLog" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web UI走 ASP.NET Core Minimal API：框架引用随 net8.0 走，不进 NuGet，
         也不引入 Autofac 之外的第二套 DI。官方 runtime:8.0 镜像已含此框架。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="ConsoleServer.Web.index.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

</Project>