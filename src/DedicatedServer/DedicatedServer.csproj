<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>GOILauncher.Multiplayer.DedicatedServer</AssemblyName>
    <RootNamespace>GOILauncher.Multiplayer.DedicatedServer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{858EE83C-5E77-42AF-9E0F-A29983265D7E}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!--
    Web SDK 提供 ASP.NET Core 共享框架和静态资源发布能力。React/Vite 的构建由
    scripts/build.ps1 和 Dockerfile 显式执行，产物再进入 wwwroot。
  -->

  <ItemGroup>
    <!--
      wwwroot 必须真的落在输出目录里，不能只依赖 Web SDK 的 static web assets。
      那套机制只在 Development 环境生效（靠 {Assembly}.staticwebassets.runtime.json 指回源码目录），
      而这个服务是直接 `dotnet GOILauncher.Multiplayer.DedicatedServer.dll` 起的，环境是 Production，
      于是 WebRootPath 找不到、css/js 全 404 —— 而且只在本地跑 build 输出时出现，publish 反而正常，
      是个很难查的不对称。显式拷贝一份，三种运行方式（build 输出 / publish / 容器）行为就一致了。
    -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

</Project>